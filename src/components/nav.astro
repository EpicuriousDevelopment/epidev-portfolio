---
import logo from "../assets/logo.svg";
---

<section id="nav" class="nav">
  <!--logo
    hrefs
    langswitch -->
  <div class="logo">
    <img src={logo.src} alt="Logo" class="logo-nav" width="64" height="64px" />
    <h1 class="logo-name">&nbspEpiDev</h1>
  </div>
  <div class="references">
    <a href="#skillsec">Vaardigheden</a>
    <a href="#contact" class="contact-ref">Contact</a>
    <a href="#projects">Projecten</a>
    
  </div>
  <div class="langswitchbtns">
    <button class="lang-btn">NL</button>
    <button class="lang-btn">EN</button>
  </div>
</section>

<style lang="scss">
  @use "../styles/variables" as *;

  .nav {
    position: sticky;
    top: 0;
    z-index: 100;

    height: 64px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 4px 32px;
border-bottom: 1px solid rgba($blue, 0.15);
    

    background-color: $navy;
  }
  .contact-ref {
    background-color: $blue;
    border-radius: 30px;
    color: $text-primary;
    padding: 10px;
  }
  .contact-ref:hover {
    cursor: pointer;
    
    transform: scale(1.04);
    transition: transform, 0.2s;
  }
  .references {
    display: flex;
    gap: 24px;
    justify-content: center;
    align-items: center;
    height: 100%;
    
  }

  .nav.scrolled {
    background: rgba($navy, 0.85);
    backdrop-filter: blur(12px);
  }
  .logo {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 8px;
  }
  .logo-name {
    color: $blue;
    font-weight: 750;
  }
  .langswitchbtns {
    display: flex;
    justify-content: flex-end;
  }
</style>

<script>
  window.addEventListener("scroll", () => {
    document
      .querySelector(".nav")
      ?.classList.toggle("scrolled", window.scrollY > 60);
  });
</script>
