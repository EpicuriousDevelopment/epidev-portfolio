        <p>{year} EpiDev</p>
        <a href="#" data-i18n="ft">Terug naar boven</a>
    </div>
</footer>

<style lang="scss">

    @use '../styles/variables' as *;
    .footer {
        border-top: 1px solid rgba($blue, 0.15);
    }
    .footer-inner {
        @include page-width;
        padding-top: 24px;
        padding-bottom: 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
    }
    p, a {
        font-size: 14px;
    }

</style>