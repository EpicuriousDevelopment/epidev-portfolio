---
import { projects } from "../data/projects.js";
---

<section id="projects" class="projects">
  <div class="section-divider">
    <span data-i18n="bp">Projecten</span>
  </div>
  <div class="project-grid">
    {
      projects.map((p, i) =>
        p.comingSoon ? (
          <div class="card soon">
            <h3 data-project-key="title" data-project-index={i}>
              {p.title.nl}
            </h3>
            <p data-project-key="coming" data-project-index={i}>{p.coming.nl}</p>
          </div>
        ) : (
          <div class={`card ${p.featured ? "featured" : ""}`}>
            
            <span class="tag" data-project-key="tag" data-project-index={i}>
              {p.tag.nl}
            </span>
            <h3 data-project-key="title" data-project-index={i}>
              {p.title.nl}
            </h3>
            <p data-project-key="description" data-project-index={i}>
              {p.description.nl}
            </p>
            <div class="stack">
              {p.stack.map((s) => (
                <span class="stack-tag">{s}</span>
              ))}
            </div>
            <div class="links">
              {p.live && (
                <a href={p.live} >
                  Live
                </a>
              )}
              {p.github && (
                <a href={p.github} >
                  Code
                </a>
              )}
            </div>
          </div>
        ),
      )
    }
  </div>
</section>
<style lang="scss">

  @use "../styles/variables" as *;
  .projects {
    @include page-width;
    padding-top: 48px;
    padding-bottom: 48px;
  }

  .project-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 12px;
  }

  @media (max-width: $bp-tablet) {
    .project-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .card {
    border: 1px solid rgba($blue, 0.15);
    border-radius: 12px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .card.featured {
    border-color: rgba($blue, 0.3);
    background: linear-gradient(
      135deg,
      rgba($blue, 0.06) 0%,
      rgba($purple, 0.03) 100%
    );
  }

  .card.soon {
    border-style: dashed;
    align-items: center;
    justify-content: center;
    text-align: center;
    opacity: 0.6;
  }

  .tag {
    font-size: 11px;
    color: $blue;
    background: rgba($blue, 0.1);
    border-radius: 4px;
    padding: 2px 8px;
    width: fit-content;
  }

  h3 {
    font-size: 15px;
    font-weight: 600;
  }

  p {
    font-size: 13px;
    color: $text-muted;
    line-height: 1.65;
  }

  .stack {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .stack-tag {
    font-size: 11px;
    color: $text-muted;
    border: 1px solid rgba($blue, 0.15);
    border-radius: 4px;
    padding: 2px 7px;
  }

  .links {
    display: flex;
    gap: 16px;
    margin-top: 4px;
  }

  .links a {
    font-size: 12px;
    color: $text-muted;

    padding: 8px 0;
  }

  .links a:hover {
    color: $text-primary;
  }

  
</style>
