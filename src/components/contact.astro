---
import { contact } from "../data/contact.js";

const linkedinLabel = contact.linkedin.replace(/^https?:\/\/(www\.)?/, "")
---
<section id="contact" class="contact">
    <div class="section-divider">
    <span data-i18n="bc">Contact</span>
  </div>

  <p class="contact-text" data-i18n="ci">
    Heb je een idee, een vraag of een project? Stuur me gerust een mailtje of een bericht op LinkedIn.
  </p>

  <div class="contact-links">
        <a class="contact-card" href={`mailto:${contact.email}`}>
            <span class="contact-label" data-i18n="ce">E-mail</span>
            <span class="contact-value">{contact.email}</span>
        </a>
        <a class="contact-card" href={contact.linkedin} target="_blank" rel="noopener noreferrer">
            <span class="contact-label">LinkedIn</span>
            <span class="contact-value">{linkedinLabel}</span>
        </a>
    </div>
</section>
<style lang="scss">

    @use '../styles/variables' as *;
    .contact {
        @include page-width;
        padding-top: 48px;
        padding-bottom: 96px;
    }
    .contact-text {
        max-width: 520px;
        margin: 0 auto 32px;
        text-align: center;
    }
    .contact-links {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 16px;
    }
    .contact-card {
        display: flex;
        flex-direction: column;
        gap: 4px;
        min-width: 240px;
        padding: 20px 24px;
        border: 1px solid rgba($blue, 0.15);
        border-radius: 12px;
        transition: border-color $transition, background $transition;

        &:hover {
            border-color: rgba($blue, 0.4);
            background: rgba($blue, 0.06);
        }
    }
    .contact-label {
        font-size: 12px;
        color: $blue;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }
    .contact-value {
        font-size: 16px;
        color: $text-primary;

        overflow-wrap: anywhere;
    }

    @media (max-width: $bp-phone) {
        .contact {
            padding-bottom: 64px;
        }
        .contact-links {
            flex-direction: column;
        }
        .contact-card {
            min-width: 0;
        }
    }

</style>