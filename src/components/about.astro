---
import logolisa from "../assets/lisa.jpg";
---
<section id="aboutsec" class="aboutsec">
    <div class="section-divider">
    <span data-i18n="ba">Over mij</span>
  </div>

  
    
</section>
<style lang="scss">
    @use '../styles/variables' as *;
    .aboutsec {
        height: 50vh;
        width: 75%;
        margin: 0 auto;
    padding: 48px;
    }
    .section-divider {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 28px;

    &::before,
    &::after {
      content: "";
      flex: 1;
      height: 1px;
      background: rgba($blue, 0.15);
    }

    span {
      font-size: 17px;
      font-weight: 600;
      color: $text-muted;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      white-space: nowrap;
    }
  }
</style>