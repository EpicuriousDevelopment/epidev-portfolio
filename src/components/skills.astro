---
import logojs from "../assets/icons8-js.svg";
import logohtml from "../assets/icons8-html.svg";
import logodata from "../assets/icons8-scatter-plot.svg";
import logopy from "../assets/icons8-python.svg";
import logoextra from "../assets/icons8-plus.svg";
---
<section id="skillsec" class="skillsec">
    
    <div class="skills">
<div class="skill-wrapper">
        <img src={logojs.src} alt="" class="logo-skill" width="64" height="64px" />
        <h2 class="skill-title">JavaScript</h2>
        <p class="skill-paragraph" data-i18n="vdj">2 jaar ervaring in NodeJS, Express en JavaScript.</p>
    </div>
    <div class="skill-wrapper">
        <img src={logohtml.src} alt="" class="logo-skill" width="64" height="64px" />
        <h2 class="skill-title">HTML/CSS</h2>
        <p class="skill-paragraph" data-i18n="vdh">3 jaar ervaring in HTML, CSS en sinds kort ook SCSS</p>
    </div>
    <div class="skill-wrapper">
        <img src={logodata.src} alt="" class="logo-skill" width="64" height="64px" />
        <h2 class="skill-title">Data Science</h2>
        <p class="skill-paragraph" data-i18n="vdd">Sinds september 2026 ben ik begonnen met mijn BSc Data Science.</p>
    </div>
    <div class="skill-wrapper">
        <img src={logopy.src} alt="" class="logo-skill" width="64" height="64px" />
        <h2 class="skill-title">Python</h2>
        <p class="skill-paragraph" data-i18n="vdp">2 jaar ervaring in Python.</p>
    </div>
    <div class="skill-wrapper">
        <img src={logoextra.src} alt="" class="logo-skill" width="64" height="64px" />
        <h2 class="skill-title" data-i18n="vto">Overig</h2>
        <p class="skill-paragraph" data-i18n="vdo">Ik heb ervaring met SQL, Astro en MongoDB.</p>
    </div>
    </div>
    
    
</section>

<style lang="scss">
    @use '../styles/variables' as *;
    .skillsec {
        height: 30vh;
        width: 100%;
        scroll-margin-top: 5vh;
        border-top: 1px solid rgba($blue, 0.15);
        text-align: center;
    }
    .skills {
        
        display: flex;
        justify-content: space-around;
        align-items: flex-start;
        padding-top: 5vh;
        height: 30vh;
    }
    .skill-wrapper {
        height: 18vh;
        width: 8vw;
        border-radius: 25px;
        padding: 10px;
        
        background: linear-gradient(
        135deg,
        rgba($blue, 0.08) 0%,
        rgba($purple, 0.05) 100%
        );
        border: 1px solid rgba($blue, 0.15);
    }
    
    
</style>