<script>
  import gsap from "gsap";
  gsap.from(".badge", {
    y: -40,
    opacity: 0,
    duration: 1,
    ease: "power2.out",
  });
  gsap.from(".cube-wrapper", {
    scale: 0,
    duration: 0.6,
    delay: 0.4,
    ease: "back.out(1.7)",
  });
  gsap.from(".double-button", {
    scale: 0,
    duration: 1.2,
    delay: 0.4,
    ease: "back.out(1.2)",
  });
  gsap.from(".blauw", {
    clipPath: "inset(0 100% 0 0)",
    duration: 1,
    delay: 0.8,
    ease: "power2.inOut",
    stagger: 0.3,
  });
</script>
