---
import LogoModel from './logomodel.astro';
---

<section id="introsec" class="introsec">
  <div class="left">
    <div class="left-top">
      <div class="beschikbaarheid-div">
        <div class="pulsecircle">

      </div>
      <h2 class="beschikbaarheid" data-i18n="bb">Beschikbaar voor projecten</h2>
      </div>
      
      <h1 class="hero-title" >
        <span data-i18n="ht">Hoi, ik ben</span> 
        <span class="blauw hero-titlename">Luuk.</span>
      </h1>
      <h4 id="hero-h4" data-i18n="hs">Freelance webdeveloper • Noord-Brabant</h4>
      
      <p class="hero-description" data-i18n="hd">Ik bouw websites en kleine software-projecten, en ben begonnen aan een bachelor Data Science aan de TU/e.</p>
      <div class="double-button">
        <a class="btn-a main-btn" data-i18n="hbp" href="#projects"> Bekijk mijn projecten </a>
        <a class="btn-a main-btn" data-i18n="hbc" href="#contact"> Contact opnemen </a>
      </div>
    </div>
    <div class="left-bottom">
      <div class="statistiek">
        <h1 class="statistiek-title blauw" >2+</h1>
        <p class="statistiek-paragraph" data-i18n="se">Jaar ervaring</p>
      </div>
      <div class="statistiek">
        <h1 class="statistiek-title blauw">1</h1>
        <p class="statistiek-paragraph" data-i18n="sp">Project live</p>
      </div>
      <div class="statistiek">
        <h1 class="statistiek-title blauw">Sep '26</h1>
        <p class="statistiek-paragraph">
          Start Data Science BSc <br />@ TU/e
        </p>
      </div>
    </div>
  </div>
  <div class="right">
    <div class="right-top">
      
      <LogoModel />
    </div>
    
  </div>
  
</section>

<style lang="scss">
 
  @use "../styles/variables" as *;


  .introsec {
    @include page-width;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 48px;
    min-height: 65vh;
    padding-top: 48px;
    padding-bottom: 48px;
  }
  .left {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .left-top {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .left-bottom {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding-top: 24px;
    border-top: 1px solid rgba($blue, 0.15);
  }
  .right {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .right-top {
    width: 100%;
    max-width: 380px;
    aspect-ratio: 1 / 1;

    min-height: 0;

    display: flex;
    justify-content: center;
    align-items: center;

    overflow: visible;

    border-radius: 24px;
    background: linear-gradient(
      135deg,
      rgba($blue, 0.08) 0%,
      rgba($purple, 0.05) 100%
    );
    border: 1px solid rgba($blue, 0.2);
    backdrop-filter: blur(12px);
  }


  .beschikbaarheid-div {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 20px;
  }
  .beschikbaarheid {
    color: $green-pulse;
    display: inline-block;
  }
  .pulsecircle {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: $green-pulse;
    position: relative;
    flex-shrink: 0;
    display: inline-block;
  }
  .pulsecircle::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 1.5px solid $green-pulse;
    opacity: 0.4;
    animation: pulse-ring 2s ease infinite;
  }
  @keyframes pulse-ring {
    0%   { transform: scale(0.8); opacity: 0.4; }
    100% { transform: scale(2);   opacity: 0; }
  }

  .hero-title {
   
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    padding-bottom: 10px;
  }
  .hero-titlename {
    background: linear-gradient(135deg, $blue 0%, $purple 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .blauw {
    color: $blue;
    display: inline-block;
  }
  #hero-h4 {
    padding-bottom: 24px;
    color: $text-muted;
    font-weight: 750;
  }
  .hero-description {
    padding-bottom: 32px;
  }
  .double-button {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  .btn-a {
    border-radius: 15px;
  }
  .main-btn {
    border-radius: 15px;
    padding: 10px 16px;
    font-size: 16px;
    border: 1px solid $blue;
    background: rgba($blue, 0.15);
    color: $text-primary;
    transition: transform 0.4s, background 0.4s;
  }
 
  @media (hover: hover) {
    .main-btn:hover {
      background: rgba($blue, 0.3);
      transform: scale(1.15);
    }
  }

  
  @media (max-width: $bp-tablet) {
    .introsec {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
      gap: 40px;
      padding-top: 32px;
      padding-bottom: 40px;
    }
    .right-top {
      max-width: 340px;
    }
  }

 
  @media (max-width: $bp-phone) {
    .left {
      gap: 32px;
    }
    .hero-description {
      padding-bottom: 24px;
    }
    .left-bottom {
      gap: 12px;
    }
    .statistiek-title {
      font-size: 1.5rem;
    }
    .statistiek-paragraph {
      font-size: 14px;
      line-height: 1.4;
    }
    .right-top {
      max-width: 280px;
    }
  }

  
</style>

<script>
  import gsap from "gsap";
  
  
  gsap.from(".double-button", {
    scale: 0,
    duration: 1.2,
    delay: 0.4,
    ease: "back.out(1.2)",
  });
  gsap.from(".blauw", {
    clipPath: "inset(0 100% 0 0)",
    duration: 1,
    delay: 0.8,
    ease: "power2.inOut",
    stagger: 0.3,
  });
  
</script>
