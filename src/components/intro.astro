---
import LogoModel from './logomodel.astro';
---

<section id="introsec" class="introsec">
  <div class="left">
    <div class="left-top">
      <div class="beschikbaarheid-div">
        <div class="pulsecircle">

      </div>
      <h2 class="beschikbaarheid" data-i18n="bb">Beschikbaar voor projecten</h2>
      </div>
      
      <h1 class="hero-title" >
        <span data-i18n="ht">Hoi, ik ben</span> 
        <span class="blauw hero-titlename">Luuk.</span>
      </h1>
      <h4 id="hero-h4" data-i18n="hs">Freelance webdeveloper • Noord-Brabant</h4>
      
      <p class="hero-description" data-i18n="hd">Ik bouw websites en kleine software-projecten, en ben begonnen aan een bachelor Data Science aan de TU/e.</p>
      <div class="double-button">
        <a class="btn-a main-btn" data-i18n="hbp" href="#projects"> Bekijk mijn projecten </a>
        <a class="btn-a main-btn" data-i18n="hbc" href="#contact"> Contact opnemen </a>
      </div>
    </div>
    <div class="left-bottom">
      <div class="statistiek">
        <h1 class="statistiek-title blauw" >2+</h1>
        <p class="statistiek-paragraph" data-i18n="se">Jaar ervaring</p>
      </div>
      <div class="statistiek">
        <h1 class="statistiek-title blauw">1</h1>
        <p class="statistiek-paragraph" data-i18n="sp">Project live</p>
      </div>
      <div class="statistiek">
        <h1 class="statistiek-title blauw">Sep '26</h1>
        <p class="statistiek-paragraph">
          Start Data Science BSc <br />@ TU/e
        </p>
      </div>
    </div>
  </div>
  <div class="right">
    <div class="right-top">
      
      <LogoModel />
    </div>
    
  </div>
  
</section>

<style lang="scss">
  @use "../styles/variables" as *;
  .introsec {
    height: 65vh;
    display: flex;
    justify-content: flex-start;
    width: 75%;
    max-width: 1920px;
    margin: 0 auto;
    padding: 0 48px;
  }
  .hero-titlename {
    background: linear-gradient(135deg, $blue 0%, $purple 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .pulsecircle {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: $green-pulse;
  position: relative;
  flex-shrink: 0;
  display: inline-block;
}

.pulsecircle::after {
  content: '';
  position: absolute;
  inset: -3px;
  border-radius: 50%;
  border: 1.5px solid $green-pulse;
  opacity: 0.4;
  animation: pulse-ring 2s ease infinite;
}

@keyframes pulse-ring {
  0%   { transform: scale(0.8); opacity: 0.4; }
  100% { transform: scale(2);   opacity: 0; }
}
.beschikbaarheid {
  color: $green-pulse;
  display: inline-block;
}
.hero-title {
  font-size: 60px;
  padding-bottom: 10px;
}
  
  .blauw {
    color: $blue;
    display: inline-block;
  }
  .main-btn {
    border-radius: 15px;
    padding: 6px;
    font-size: 16px;
    border: 1px solid $blue;
    background: rgba($blue, 0.15);
    color: $text-primary;
    transition: transform .4s;
  }
  .btn-a {
    border-radius: 15px;
  }
  .btn-a:hover {
    cursor: pointer;
  }
  .main-btn:hover {
    cursor: pointer;
    background: rgba($blue, 0.3);
    transform: scale(1.15);
    transition: transform, 0.5s;
  }
  .left {
    height: 65vh;
    
    flex: 1;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    
  }
  .right {
    height: 65vh;

    flex: 1;
    display: flex;
    
    justify-content: center;
    align-items: center;
    
  }
  .beschikbaarheid-div {
  
  display: flex;
  align-items: center;
  
  gap: 8px;
  margin-bottom: 20px;
  margin-top: 7vh;
}
  #hero-h4 {
    padding-bottom: 40px;
    color: $text-muted;
    font-weight: 750;
  }
  .hero-description {
    padding-bottom: 100px;
  }
  .left-top {
    height: 60%;
    
    width: 65%;
    display: flex;
    flex-wrap: wrap;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }
  .left-bottom {
    height: 20%;
    
    width: 65%;
    display: flex;
    justify-content: space-around;
    align-items: center;
    border-top: 1px solid rgba($blue, 0.15);
  }

  .right-top {
    width: 65%;
    height: 65%;

    display: flex;
    justify-content: center;
    align-items: center;

    overflow: visible;

    border-radius: 24px;
    background: linear-gradient(
      135deg,
      rgba($blue, 0.08) 0%,
      rgba($purple, 0.05) 100%
    );
    border: 1px solid rgba($blue, 0.2);
    backdrop-filter: blur(12px);
  }
  
  .double-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3vw;

    
  }
  
</style>

<script>
  import gsap from "gsap";
  
  
  gsap.from(".double-button", {
    scale: 0,
    duration: 1.2,
    delay: 0.4,
    ease: "back.out(1.2)",
  });
  gsap.from(".blauw", {
    clipPath: "inset(0 100% 0 0)",
    duration: 1,
    delay: 0.8,
    ease: "power2.inOut",
    stagger: 0.3,
  });
  
</script>
