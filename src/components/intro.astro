---
import LogoModel from './logomodel.astro';
---

<section id="introsec" class="introsec">
  <div class="left">
    <div class="left-top">
      <div class="beschikbaarheid-div">
        <div class="pulsecircle">

      </div>
      <h2 class="beschikbaarheid" data-i18n="bb">Beschikbaar voor projecten</h2>
      </div>
      
      <h1 class="hero-title" >
        <span data-i18n="ht">Hoi, ik ben</span> 
        <span class="blauw hero-titlename">Luuk.</span>
      </h1>
      <h4 id="hero-h4">Freelance webdeveloper • Noord-Brabant</h4>
      
      <p class="hero-description" data-i18n="hd">Ik ben een 18 jaar oude beginnende developer die graag wilt beginnen met het opbouwen van een sterk portfolio met veel diverse projecten zoals websites en software.</p>
      <div class="double-button">
        <a class="btn-a main-btn" data-i18n="hbp" href="#projects"> Bekijk mijn projecten </a>
        <a class="btn-a main-btn" data-i18n="hbc" href="#contact"> Contact opnemen </a>
      </div>
    </div>
    <div class="left-bottom">
      <div class="statistiek">
        <h1 class="statistiek-title blauw" >2+</h1>
        <p class="statistiek-paragraph" data-i18n="se">Jaar ervaring</p>
      </div>
      <div class="statistiek">
        <h1 class="statistiek-title blauw">1</h1>
        <p class="statistiek-paragraph" data-i18n="sp">Project live</p>
      </div>
      <div class="statistiek">
        <h1 class="statistiek-title blauw">Sep '26</h1>
        <p class="statistiek-paragraph">
          Start Data Science BSc <br />@ TU/e
        </p>
      </div>
    </div>
  </div>
  <div class="right">
    <div class="right-top">
      <!-- <div class="cube-wrapper">
        <div class="cube">
          <div class="face frontc"></div>
          <div class="face backc"></div>
          <div class="face leftc"></div>
          <div class="face rightc"></div>
          <div class="face topc"></div>
          <div class="face bottomc"></div>
        </div>
        <div class="cube-shadow"></div>
        
      </div> --> 
      <LogoModel />
    </div>
    <div class="right-middle"></div>
    <div class="right-bottom"></div>
  </div>
  
</section>

<style lang="scss">
  @use "../styles/variables" as *;
  .cube-wrapper {
    perspective: 600px;
    position: relative;
    width: 150px;
    height: 150px;
    margin-bottom: 24px;
    transform-style: preserve-3d;
  }

  .cube {
    width: 150px;
    height: 150px;
    position: relative;
    transform-style: preserve-3d;
    animation: rotate 8s infinite linear;
  }

  .face {
    position: absolute;
    width: 150px;
    height: 150px;
  }

  .frontc {
    transform: translateZ(75px);
    background: $blue;
  }
  .backc {
    transform: rotateY(180deg) translateZ(75px);
    background: darken($blue, 15%);
  }
  .leftc {
    transform: rotateY(-90deg) translateZ(75px);
    background: darken($blue, 8%);
  }
  .rightc {
    transform: rotateY(90deg) translateZ(75px);
    background: darken($blue, 5%);
  }
  .topc {
    transform: rotateX(90deg) translateZ(75px);
    background: lighten($blue, 10%);
  }
  .bottomc {
    transform: rotateX(-90deg) translateZ(75px);
    background: darken($blue, 20%);
  }

  @keyframes rotate {
    0% {
      transform: rotateX(0deg) rotateY(0deg);
    }
    25% {
      transform: rotateX(20deg) rotateY(90deg);
    }
    50% {
      transform: rotateX(0deg) rotateY(180deg);
    }
    75% {
      transform: rotateX(-20deg) rotateY(270deg);
    }
    100% {
      transform: rotateX(0deg) rotateY(360deg);
    }
  }

  .cube-shadow {
    width: 150px;
    height: 30px;
    background: radial-gradient(ellipse, rgba($blue, 0.4) 0%, transparent 70%);
    margin-top: 18.75px;
    animation: shadow-pulse 8s infinite linear;
    border-radius: 50%;
    position: absolute;
    left: 0;
    top: 170px;
  }

  @keyframes shadow-pulse {
    0% {
      transform: scaleX(1);
      opacity: 0.6;
    }
    25% {
      transform: scaleX(0.85);
      opacity: 0.4;
    }
    50% {
      transform: scaleX(1);
      opacity: 0.6;
    }
    75% {
      transform: scaleX(0.85);
      opacity: 0.4;
    }
    100% {
      transform: scaleX(1);
      opacity: 0.6;
    }
  }
  .introsec {
    height: 65vh;
    display: flex;
    justify-content: flex-start;
    width: 75%;
    max-width: 1920px;
    margin: 0 auto;
    padding: 0 48px;
  }
  .hero-titlename {
    background: linear-gradient(135deg, $blue 0%, $purple 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .pulsecircle {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: $green-pulse;
  position: relative;
  flex-shrink: 0;
  display: inline-block;
}

.pulsecircle::after {
  content: '';
  position: absolute;
  inset: -3px;
  border-radius: 50%;
  border: 1.5px solid #22c55e;
  opacity: 0.4;
  animation: pulse-ring 2s ease infinite;
}

@keyframes pulse-ring {
  0%   { transform: scale(0.8); opacity: 0.4; }
  100% { transform: scale(2);   opacity: 0; }
}
.beschikbaarheid {
  color: $green-pulse;
  display: inline-block;
}
.hero-title {
  font-size: 60px;
  padding-bottom: 10px;
}
  .jobtitle {
  }
  .blauw {
    color: $blue;
    display: inline-block;
  }
  .main-btn {
    border-radius: 15px;
    padding: 6px;
    font-size: 16px;
    border: 1px solid $blue;
    background: rgba($blue, 0.15);
    color: $text-primary;
    transition: transform .4s;
  }
  .btn-a {
    border-radius: 15px;
  }
  .btn-a:hover {
    cursor: pointer;
  }
  .main-btn:hover {
    cursor: pointer;
    background: rgba($blue, 0.3);
    transform: scale(1.15);
    transition: transform, 0.5s;
  }
  .left {
    height: 65vh;
    
    flex: 1;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    
  }
  .right {
    height: 65vh;

    flex: 1;
    display: flex;
    
    justify-content: center;
    align-items: center;
    
  }
  .beschikbaarheid-div {
  
  display: flex;
  align-items: center;
  
  gap: 8px;
  margin-bottom: 20px;
  margin-top: 7vh;
}
  #hero-h4 {
    padding-bottom: 40px;
    color: $text-muted;
    font-weight: 750;
  }
  .hero-description {
    padding-bottom: 100px;
  }
  .left-top {
    height: 60%;
    
    width: 65%;
    display: flex;
    flex-wrap: wrap;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }
  .left-bottom {
    height: 20%;
    
    width: 65%;
    display: flex;
    justify-content: space-around;
    align-items: center;
    border-top: 1px solid rgba($blue, 0.15);
  }

  .right-top {
    width: 65%;
    height: 65%;

    display: flex;
    justify-content: center;
    align-items: center;

    overflow: visible;

    border-radius: 24px;
    background: linear-gradient(
      135deg,
      rgba($blue, 0.08) 0%,
      rgba(139, 92, 246, 0.05) 100%
    );
    border: 1px solid rgba($blue, 0.2);
    backdrop-filter: blur(12px);
  }
  
  .double-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3vw;

    
  }
  
</style>

<script>
  import gsap from "gsap";
  
  gsap.from(".badge", {
    y: -40,
    opacity: 0,
    duration: 1,
    ease: "power2.out",
  });
  gsap.from(".cube-wrapper", {
    scale: 0,
    duration: 0.6,
    delay: 0.4,
    ease: "back.out(1.7)",
  });
  gsap.from(".double-button", {
    scale: 0,
    duration: 1.2,
    delay: 0.4,
    ease: "back.out(1.2)",
  });
  gsap.from(".blauw", {
    clipPath: "inset(0 100% 0 0)",
    duration: 1,
    delay: 0.8,
    ease: "power2.inOut",
    stagger: 0.3,
  });
  
</script>
