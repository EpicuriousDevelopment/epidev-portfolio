<style lang="scss">
  @use "../styles/variables" as *;
  .cube-wrapper {
    perspective: 600px;
    position: relative;
    width: 150px;
    height: 150px;
    margin-bottom: 24px;
    transform-style: preserve-3d;
  }

  .cube {
    width: 150px;
    height: 150px;
    position: relative;
    transform-style: preserve-3d;
    animation: rotate 8s infinite linear;
  }

  .face {
    position: absolute;
    width: 150px;
    height: 150px;
  }

  .frontc {
    transform: translateZ(75px);
    background: $blue;
  }
  .backc {
    transform: rotateY(180deg) translateZ(75px);
    background: darken($blue, 15%);
  }
  .leftc {
    transform: rotateY(-90deg) translateZ(75px);
    background: darken($blue, 8%);
  }
  .rightc {
    transform: rotateY(90deg) translateZ(75px);
    background: darken($blue, 5%);
  }
  .topc {
    transform: rotateX(90deg) translateZ(75px);
    background: lighten($blue, 10%);
  }
  .bottomc {
    transform: rotateX(-90deg) translateZ(75px);
    background: darken($blue, 20%);
  }

  @keyframes rotate {
    0% {
      transform: rotateX(0deg) rotateY(0deg);
    }
    25% {
      transform: rotateX(20deg) rotateY(90deg);
    }
    50% {
      transform: rotateX(0deg) rotateY(180deg);
    }
    75% {
      transform: rotateX(-20deg) rotateY(270deg);
    }
    100% {
      transform: rotateX(0deg) rotateY(360deg);
    }
  }

  .cube-shadow {
    width: 150px;
    height: 30px;
    background: radial-gradient(ellipse, rgba($blue, 0.4) 0%, transparent 70%);
    margin-top: 18.75px;
    animation: shadow-pulse 8s infinite linear;
    border-radius: 50%;
    position: absolute;
    left: 0;
    top: 170px;
  }

  @keyframes shadow-pulse {
    0% {
      transform: scaleX(1);
      opacity: 0.6;
    }
    25% {
      transform: scaleX(0.85);
      opacity: 0.4;
    }
    50% {
      transform: scaleX(1);
      opacity: 0.6;
    }
    75% {
      transform: scaleX(0.85);
      opacity: 0.4;
    }
    100% {
      transform: scaleX(1);
      opacity: 0.6;
    }
  }
  .introsec {
    height: 65vh;
    display: flex;
    justify-content: flex-start;
    width: 75%;
    max-width: 1920px;
    margin: 0 auto;
    padding: 0 48px;
  }
  .hero-titlename {
    background: linear-gradient(135deg, $blue 0%, $purple 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .pulsecircle {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: $green-pulse;
  position: relative;
  flex-shrink: 0;
  display: inline-block;
}

.pulsecircle::after {
  content: '';
  position: absolute;
  inset: -3px;
  border-radius: 50%;
  border: 1.5px solid #22c55e;
  opacity: 0.4;
  animation: pulse-ring 2s ease infinite;
}

@keyframes pulse-ring {
  0%   { transform: scale(0.8); opacity: 0.4; }
  100% { transform: scale(2);   opacity: 0; }
}
.beschikbaarheid {
  color: $green-pulse;
  display: inline-block;
}
.hero-title {
  font-size: 60px;
  padding-bottom: 10px;
}
