---
import Nav from '../components/nav.astro';
import Footer from '../components/footer.astro';
---
<html lang="nl">

  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EpiDev | Freelance webdeveloper</title>
    <meta name="description" content="Portfolio van EpiDev, freelance webdeveloper uit Noord-Brabant." />
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>

  <body>
    <Nav />
    <slot />
    <Footer />
  </body>
</html>

<style is:global lang="scss">
  @use "../styles/variables" as *;

  html {
    scroll-behavior: smooth;
    
    scroll-padding-top: 80px;
    max-width: 100%;

    @media (max-width: $bp-phone) {
      scroll-padding-top: 112px;
    }
    body {
      background: $background;
      color: $text-primary;
      font-family: $font-sans;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
      margin: 0;
      padding: 0;
    }

    h1, h2, h3, h4, h5, h6 {
      color: $text-primary;
      line-height: 1.2;
      letter-spacing: -0.02em;
    }

    p {
      color: $text-muted;
      line-height: 1.75;
    }

    h1, h2, h3, h4, h5, h6, p {
      margin: 0;
      padding: 0;
    }

    a {
      color: $text-muted;
      text-decoration: none;
      transition: color $transition;
      font-weight: bold;

      &:hover {
        color: white;
      }
    }

    ::selection {
      background: rgba($blue, 0.3);
      color: $text-primary;
    }
  }

  .section-divider {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 28px;

    &::before,
    &::after {
      content: "";
      flex: 1;
      height: 1px;
      background: rgba($blue, 0.15);
    }

    span {
      font-size: 17px;
      font-weight: 600;
      color: $text-muted;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      white-space: nowrap;
    }
  }
</style>

<script>
  import '../scripts/langswitch.js';
</script>